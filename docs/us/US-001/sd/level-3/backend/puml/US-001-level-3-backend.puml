@startuml
title US-001 - Register organization and admin - SD level 3 - Backend
hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam maxMessageSize 75
skinparam ParticipantBackgroundColor #EAF2F8
skinparam ActorBackgroundColor #FEF9E7
skinparam NoteBackgroundColor #FFF8DC
autonumber

participant "Web App" as FE
participant "OrganizationsController" as Controller
participant "OrganizationService" as Service
participant "IPlanRepository" as PlanRepo
participant "OrganizationMapper" as Mapper
participant "PasswordHasher<Account>" as Hasher
participant "IAccountRepository" as AccountRepo
participant "IOrganizationRepository" as OrgRepo
participant "NexoDbContext" as DbContext
participant "IEmailSender" as Email
participant "Database" as DB

note over Controller, DB
  Password path. The rate limiter ("public" policy) runs before the
  controller and answers 429 when the address exceeds its limit.
end note

activate FE
FE -> Controller: POST /organizations (RegisterOrganizationDto dto)
activate Controller
Controller -> Service: Register(dto)
activate Service
alt Missing or invalid required fields
    Service --> Controller: Validation failure
    Controller --> FE: 400 Bad Request
else Valid input
    Service -> PlanRepo: GetByIdAsync(dto.PlanId)
    activate PlanRepo
    PlanRepo -> DB: SELECT Plan by Id
    activate DB
    DB --> PlanRepo: Plan or none
    deactivate DB
    PlanRepo --> Service: Plan or null
    deactivate PlanRepo
    alt Unknown plan
        Service --> Controller: Validation failure (PlanId)
        Controller --> FE: 400 Bad Request
    else Plan found
        Service -> Mapper: ToOrganization(dto, plan)
        activate Mapper
        Mapper --> Service: new Organization
        deactivate Mapper
        Service -> Mapper: ToAdminAccount(dto, organization, confirmation token hash, expiry)
        activate Mapper
        Mapper -> Hasher: HashPassword(account, dto.Password)
        activate Hasher
        Hasher --> Mapper: Password hash
        deactivate Hasher
        Mapper --> Service: new Account(role: Admin, status: Unverified)
        deactivate Mapper
        Service -> AccountRepo: FindByEmailAsync(normalized email)
        activate AccountRepo
        AccountRepo -> DB: SELECT Account by Email
        activate DB
        DB --> AccountRepo: Query result
        deactivate DB
        AccountRepo --> Service: existing Account or null
        deactivate AccountRepo
        alt Email has an account that is not an expired unconfirmed registration
            Service -> Email: SendAsync(AlreadyRegistered notice)
            activate Email
            Email --> Service: Sent
            deactivate Email
            Service --> Controller: Done (nothing written)
            Controller --> FE: 202 Accepted
        else Email free, or its unconfirmed registration expired
            opt Expired unconfirmed registration
                Service -> DbContext: Remove old account and organization
                activate DbContext
                DbContext --> Service: Tracked as Deleted
                deactivate DbContext
            end
            Service -> OrgRepo: Add(organization)
            activate OrgRepo
            OrgRepo --> Service: Tracked as Added
            deactivate OrgRepo
            Service -> AccountRepo: Add(account)
            activate AccountRepo
            AccountRepo --> Service: Tracked as Added
            deactivate AccountRepo
            Service -> DbContext: SaveChangesOrConflictAsync()
            activate DbContext
            DbContext -> DB: DELETE replaced rows, INSERT Organization, Account
            activate DB
            DB --> DbContext: Committed, or unique violation
            deactivate DB
            DbContext --> Service: Saved, or ConflictException
            deactivate DbContext
            alt Same email registered concurrently
                Service --> Controller: throw ConflictException
                Controller --> FE: 409 Conflict
            else Saved
                Service -> Email: SendAsync(Confirmation link)
                activate Email
                Email --> Service: Sent, or failure
                deactivate Email
                alt Sent
                    Service --> Controller: Done
                    Controller --> FE: 202 Accepted
                else Email failed
                    Service -> DbContext: Remove organization and account; save
                    activate DbContext
                    DbContext --> Service: Removed
                    deactivate DbContext
                    Service --> Controller: Failure
                    Controller --> FE: 500 Internal Server Error
                end
            end
        end
    end
end
deactivate Service
deactivate Controller
deactivate FE
@enduml
