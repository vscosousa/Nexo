@startuml
actor "Prospective Admin" as Admin
participant "Web UI" as UI
participant "OrganizationsController" as Controller
participant "OrganizationService" as Service
participant "IAccountRepository" as AccountRepo
participant "IOrganizationRepository" as OrgRepo
participant "OrganizationMapper" as Mapper
participant "NexoDbContext" as DbContext

Admin -> UI: Submit organization and admin details
UI -> Controller: POST /organizations (RegisterOrganizationDto dto)
Controller -> Service: Register(dto)
Service -> AccountRepo: FindByEmail(dto.AdminEmail)
AccountRepo --> Service: null (if not found)
alt Email already has an account
    Service --> Controller: throw ConflictException
    Controller --> UI: 409 Conflict
else Email available
    Service -> Mapper: ToOrganization(dto)
    Mapper --> Service: new Organization(name, plan: Free)
    Service -> Mapper: ToAdminAccount(dto, organization)
    Mapper --> Service: new Account(email, role: Admin, organization)
    Service -> OrgRepo: Add(organization)
    Service -> AccountRepo: Add(account)
    Service -> DbContext: SaveChangesAsync()
    DbContext --> Service: committed
    Service --> Controller: OrganizationDto
    Controller --> UI: 201 Created (OrganizationDto)
end
UI --> Admin: Show result and sign in on success
@enduml
