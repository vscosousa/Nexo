@startuml
actor "Invited Person" as Person
participant "Web UI" as UI
participant "AccountsController" as Controller
participant "AccountService" as Service
participant "IEligibleEmailRepository" as EligibleRepo
participant "IAccountRepository" as AccountRepo
participant "AccountMapper" as Mapper
participant "NexoDbContext" as DbContext

Person -> UI: Submit account details
UI -> Controller: POST /accounts (dto)
Controller -> Service: Register(dto)
Service -> EligibleRepo: FindByEmail(dto.Email)
alt No eligible email found
    Service --> Controller: throw ForbiddenException (not registered to any organization)
    Controller --> UI: 403 Forbidden
else Eligible email found
    Service -> AccountRepo: FindByEmail(dto.Email)
    alt Account already exists
        Service --> Controller: throw ConflictException
        Controller --> UI: 409 Conflict
    else No existing account
        Service -> Mapper: ToMemberAccount(dto, eligibleEmail.OrganizationId)
        Mapper --> Service: new Account(email, role: Member, organization)
        Service -> AccountRepo: Add(account)
        Service -> EligibleRepo: Remove(eligibleEmail)
        Service -> DbContext: SaveChangesAsync()
        DbContext --> Service: committed
        Service --> Controller: AccountDto
        Controller --> UI: 201 Created (AccountDto)
    end
end
UI --> Person: Show result and sign in on success
@enduml
