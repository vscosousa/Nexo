@startuml
actor "Invited Person" as Person
participant "Nexo" as System
Person -> System: Activate account (email, name, password)
activate System
System -> System: Check a pending account exists for the email and is not already active
alt Pending account found and not yet active
    System --> Person: Account activated and signed in
else No account for the email, or already active
    System --> Person: Activation rejected (not eligible or conflict error)
end
deactivate System
@enduml
