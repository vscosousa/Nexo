@startuml
title US-005 - Sign in - SD level 3 - Backend
hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam maxMessageSize 75
skinparam ParticipantBackgroundColor #EAF2F8
skinparam ActorBackgroundColor #FEF9E7
skinparam NoteBackgroundColor #FFF8DC
autonumber

participant "Web App" as FE
participant "AuthController" as Controller
participant "AuthService" as Service
participant "IAccountRepository" as AccountRepo
participant "PasswordHasher<Account>" as Hasher
participant "ITokenService" as TokenService
participant "IEmailSender" as Email
participant "Database" as DB

note over Controller, DB
  Password flow only. The "sign-in" rate limiter runs before the controller (429).
  Every 401 has the same body, so the cause is not revealed.
end note

activate FE
FE -> Controller: POST /auth/sign-in (dto)
activate Controller
Controller -> Service: SignIn(dto)
activate Service
alt Missing or invalid required fields
    Service --> Controller: Validation failure
    Controller --> FE: 400 Bad Request
else Valid input
    Service -> AccountRepo: FindByEmailAsync(normalized email)
    activate AccountRepo
    AccountRepo -> DB: SELECT Account by Email
    activate DB
    DB --> AccountRepo: Query result
    deactivate DB
    AccountRepo --> Service: existing Account or null
    deactivate AccountRepo
    Service -> Hasher: VerifyHashedPassword(account hash, or a dummy hash when no eligible account)
    activate Hasher
    Hasher --> Service: match or mismatch
    deactivate Hasher
    alt No account, not Active, no password set, or locked
        opt Locked and the unlock link has expired
            Service -> DB: Replace the expired link (new hash, expires in 24 hours)
            activate DB
            DB --> Service: Replaced (0 or 1)
            deactivate DB
            Service -> Email: SendAsync(fresh unlock link)
            activate Email
            Email --> Service: Sent
            deactivate Email
        end
        Service --> Controller: throw UnauthorizedException (generic)
        Controller --> FE: 401 Unauthorized
    else Password does not match
        Service -> DB: FailedSignInAttempts + 1
        activate DB
        DB --> Service: Updated
        deactivate DB
        Service -> DB: Lock if attempts >= 5 and not locked\n(UnlockTokenHash, SessionVersion + 1)
        activate DB
        DB --> Service: Rows locked (0 or 1)
        deactivate DB
        opt Just locked
            Service -> Email: SendAsync(Unlock link /unlock?email&token)
            activate Email
            Email --> Service: Sent (on failure the lock is undone)
            deactivate Email
        end
        Service --> Controller: throw UnauthorizedException (generic)
        Controller --> FE: 401 Unauthorized
    else Password matches
        opt Earlier failed attempts
            Service -> DB: FailedSignInAttempts = 0
            activate DB
            DB --> Service: Updated
            deactivate DB
        end
        Service -> TokenService: GenerateToken(account)
        activate TokenService
        TokenService --> Service: JWT (sub, orgId, role, sv; iss/aud)
        deactivate TokenService
        Service --> Controller: SessionDto
        Controller --> FE: 204 No Content (Set-Cookie: nexo_session)
    end
end
deactivate Service
deactivate Controller
deactivate FE
@enduml
