@startuml
actor "Admin" as Admin
participant "Web UI" as UI
participant "EligibleEmailsController" as Controller
participant "EligibleEmailService" as Service
participant "IAccountRepository" as AccountRepo
participant "IOrganizationRepository" as OrgRepo
participant "IEligibleEmailRepository" as EligibleRepo
participant "EligibleEmailMapper" as Mapper
participant "NexoDbContext" as DbContext

Admin -> UI: Submit member email
UI -> Controller: POST /organizations/{organizationId}/eligible-emails (dto)
Controller -> Service: Register(organizationId, callerAccountId, dto)
Service -> AccountRepo: GetById(callerAccountId)
AccountRepo --> Service: caller Account
alt Caller is not Admin of organizationId
    Service --> Controller: throw ForbiddenException
    Controller --> UI: 403 Forbidden
else Caller authorized
    Service -> OrgRepo: GetById(organizationId)
    OrgRepo --> Service: Organization (MemberLimit)
    Service -> AccountRepo: CountByOrganization(organizationId)
    AccountRepo --> Service: current account count
    alt Member limit reached
        Service --> Controller: throw ConflictException (limit reached)
        Controller --> UI: 409 Conflict
    else Under limit
        Service -> AccountRepo: FindByEmail(dto.Email)
        Service -> EligibleRepo: FindByEmail(dto.Email)
        alt Email already registered (account or eligible list)
            Service --> Controller: throw ConflictException (already registered)
            Controller --> UI: 409 Conflict
        else Email available
            Service -> Mapper: ToEligibleEmail(dto, organizationId)
            Mapper --> Service: new EligibleEmail(email, organization)
            Service -> EligibleRepo: Add(eligibleEmail)
            Service -> DbContext: SaveChangesAsync()
            DbContext --> Service: committed
            Service --> Controller: EligibleEmailDto
            Controller --> UI: 201 Created (EligibleEmailDto)
        end
    end
end
UI --> Admin: Show result
@enduml
