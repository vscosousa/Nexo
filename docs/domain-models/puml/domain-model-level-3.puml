@startuml
title Domain model - Level 3\nProposed; business entities are not implemented

hide empty members
hide circle
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 45
skinparam class {
    BackgroundColor #FEF9E7
    BackgroundColor<<valueObject>> #D6EAF8
    ArrowColor #34495E
}
skinparam packageBackgroundColor #EBF5FB

package "Organization\n(proposed aggregate)" as OrganizationAggregate {
    entity Organization <<entity>> <<root>> {}
    class "Name" as OrganizationName <<valueObject>> {}
    class "Plan" as OrganizationPlan <<valueObject>> {}
    class "MemberLimit" as OrganizationMemberLimit <<valueObject>> {}
}

package "Account\n(proposed aggregate)" as AccountAggregate {
    entity Account <<entity>> <<root>> {}
    class "Email" as AccountEmail <<valueObject>> {}
    class "Name" as AccountName <<valueObject>> {}
    class "PasswordHash" as AccountPasswordHash <<valueObject>> {}
    class "Role" as AccountRole <<valueObject>> {}
    class "Status" as AccountStatus <<valueObject>> {}
}

package "ExternalLogin\n(proposed aggregate)" as ExternalLoginAggregate {
    entity ExternalLogin <<entity>> <<root>> {}
    class "Provider" as ExternalLoginProvider <<valueObject>> {}
    class "ProviderKey" as ExternalLoginProviderKey <<valueObject>> {}
}

package "Resource\n(proposed aggregate)" as ResourceAggregate {
    entity Resource <<entity>> <<root>> {}
    class "Name" as ResourceName <<valueObject>> {}
    class "Type" as ResourceType <<valueObject>> {}
    class "Description" as ResourceDescription <<valueObject>> {}
    class "Status" as ResourceStatus <<valueObject>> {}
}

package "Reservation\n(proposed aggregate)" as ReservationAggregate {
    entity Reservation <<entity>> <<root>> {}
    class "StartAt" as ReservationStartAt <<valueObject>> {}
    class "EndAt" as ReservationEndAt <<valueObject>> {}
    class "Status" as ReservationStatus <<valueObject>> {}
}

package "Loan\n(proposed aggregate)" as LoanAggregate {
    entity Loan <<entity>> <<root>> {}
    class "Status" as LoanStatus <<valueObject>> {}
    class "RequestedAt" as LoanRequestedAt <<valueObject>> {}
    class "DeliveredAt" as LoanDeliveredAt <<valueObject>> {}
    class "ReturnedAt" as LoanReturnedAt <<valueObject>> {}
}

package "Incident\n(proposed aggregate)" as IncidentAggregate {
    entity Incident <<entity>> <<root>> {}
    class "Description" as IncidentDescription <<valueObject>> {}
    class "Status" as IncidentStatus <<valueObject>> {}
}

package "HistoryEntry\n(proposed aggregate)" as HistoryEntryAggregate {
    entity HistoryEntry <<entity>> <<root>> {}
    class "EntityName" as HistoryEntryEntityName <<valueObject>> {}
    class "EntityId" as HistoryEntryEntityId <<valueObject>> {}
    class "ChangeType" as HistoryEntryChangeType <<valueObject>> {}
    class "ChangedAt" as HistoryEntryChangedAt <<valueObject>> {}
}

package "Notification\n(proposed aggregate)" as NotificationAggregate {
    entity Notification <<entity>> <<root>> {}
    class "Message" as NotificationMessage <<valueObject>> {}
    class "SentAt" as NotificationSentAt <<valueObject>> {}
}


Organization "1" --> "1..*" Account : has
Organization "1" --> "0..*" Resource : owns
Account "1" --> "0..*" ExternalLogin : links
Account "1" --> "0..*" Reservation : requests
Account "1" --> "0..*" Loan : requests
Account "1" --> "0..*" Incident : reports
Account "0..1" --> "0..*" HistoryEntry : attributed changes
Account "1" --> "0..*" Notification : receives
Resource "1" --> "0..*" Reservation : is reserved via
Resource "1" --> "0..*" Loan : is loaned via
Resource "0..1" --> "0..*" Incident : is affected by

Organization "1" --> "1" OrganizationName : has
Organization "1" --> "1" OrganizationPlan : has
Organization "1" --> "1" OrganizationMemberLimit : has
Account "1" --> "1" AccountEmail : has
Account "1" --> "0..1" AccountName : has
Account "1" --> "0..1" AccountPasswordHash : has
Account "1" --> "1" AccountRole : has
Account "1" --> "1" AccountStatus : has
ExternalLogin "1" --> "1" ExternalLoginProvider : has
ExternalLogin "1" --> "1" ExternalLoginProviderKey : has
Resource "1" --> "1" ResourceName : has
Resource "1" --> "1" ResourceType : has
Resource "1" --> "0..1" ResourceDescription : has
Resource "1" --> "1" ResourceStatus : has
Reservation "1" --> "1" ReservationStartAt : has
Reservation "1" --> "1" ReservationEndAt : has
Reservation "1" --> "1" ReservationStatus : has
Loan "1" --> "1" LoanStatus : has
Loan "1" --> "1" LoanRequestedAt : has
Loan "1" --> "0..1" LoanDeliveredAt : has
Loan "1" --> "0..1" LoanReturnedAt : has
Incident "1" --> "1" IncidentDescription : has
Incident "1" --> "1" IncidentStatus : has
HistoryEntry "1" --> "1" HistoryEntryEntityName : has
HistoryEntry "1" --> "1" HistoryEntryEntityId : has
HistoryEntry "1" --> "1" HistoryEntryChangeType : has
HistoryEntry "1" --> "1" HistoryEntryChangedAt : has
Notification "1" --> "1" NotificationMessage : has
Notification "1" --> "1" NotificationSentAt : has

note top of Account
  Invited: no name or credentials yet.
  Active: password and/or external login.
  Active is an account state, not a session.
  Email is unique across accounts.
end note

note top of Organization
  Created with one Active Admin (US-001).
  Free plan: MemberLimit = 20.
  Counting rule and activation enforcement
  still need review (US-002 / US-003).
end note

note bottom of ExternalLogin
  Unique (Provider, ProviderKey).
  Each external login belongs to one Account.
end note

legend bottom left
  1 = exactly one; 0..1 = optional; 0..* = zero or more; 1..* = one or more.
  Incident -> Resource is optional in the current proposal; final scope is open.
  HistoryEntry may have no Account (system or unattributed change).
  Reservation, Loan, Incident, HistoryEntry, Notification remain provisional.
  Attribute nodes are scoped to their owner: Status is not one shared lifecycle.
  Loan delivery/return timestamps are absent until those events occur.
  Aggregate boundaries are proposals, not an accepted consequence of ADR-002.
  Cross-aggregate arrows express associations, not ownership or cascade deletion.
endlegend
@enduml
