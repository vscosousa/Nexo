# Template for local settings. Copy it to `.env` (git-ignored) and edit; every value is optional.
# Docker Compose reads `.env` automatically. Never commit `.env` or the mail data folder.

# Where the fake mail server keeps received emails (one .eml file each). The default is git-ignored.
# Point it elsewhere to keep mail outside the repository.
MAIL_DATA_DIR=./.data/mail

# Outgoing email from the API. Without these lines the API sends to the fake mail server ("mail" service).
# To use a real SMTP provider instead, uncomment and fill in the values from your provider:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_ENABLE_SSL=true
# EMAIL_USERNAME=your-smtp-username
# EMAIL_PASSWORD=your-smtp-password
# EMAIL_FROM=Nexo <no-reply@your-domain.example>

# Public address of the web app, used for the links inside emails.
# EMAIL_WEB_BASE_URL=http://localhost:5173

# Signing key for session tokens (compose has a local-development default) and Google sign-in credentials.
# JWT_KEY=change-me-to-at-least-32-bytes
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
